# Environment Configuration Example
# Copy to .env for local development or set these variables in the Render Dashboard

# Flask Secret Key (Generate a random 32+ character string for production)
SECRET_KEY=your-secure-random-secret-key-here
PORT=5001

# Diagnostic Laboratory Processing Portal REST API
# Set to your deployed Laboratory Portal Render URL (e.g., https://lab-portal.onrender.com)
LAB_API_URL=https://your-laboratory-portal.onrender.com
LAB_API_KEY=your-laboratory-api-key-here
LAB_API_TIMEOUT=15
USE_REST_API=True
